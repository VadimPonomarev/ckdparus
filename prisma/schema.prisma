generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          String   @id @default(cuid())
  username    String   @unique @default("admin")
  password    String   // Будем хранить хешированный пароль
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("admins")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  briefdescription String?
  fulldescription String?
  date        DateTime
  location    String?
  payUrl      String?
  price       Int?
  imageUrl    String?  @map("image_url")
  category    String?
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  views       Int      @default(0)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("events")
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  imageUrl    String?  @map("image_url") // Главное изображение (обложка)
  images      NewsImage[] // Галерея изображений
  isPublished Boolean  @default(true) @map("is_published")
  views       Int      @default(0)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("news")
}

model NewsImage {
  id          String   @id @default(cuid())
  newsId      String   @map("news_id")
  url         String
  alt         String?
  caption     String?
  order       Int      @default(0) // Порядок отображения
  
  news        News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("news_images")
}

model Team {
  id                  String   @id @default(cuid())
  name                String   // Название коллектива
  slug                String   @unique // URL-friendly название
  
  // Основные характеристики
  description         String?  // Краткое описание
  foundationDate      String?  @map("foundation_date") // Дата основания
  titleAwardDate      String?  @map("title_award_date") // Дата присвоения звания
  lastConfirmation    String?  @map("last_confirmation") // Дата последнего подтверждения
  confirmationOrder   String?  @map("confirmation_order") // Номер приказа подтверждения
  
  // Руководство
  leaderName          String?  @map("leader_name") // ФИО основного руководителя
  leaderNameSecondary String?  @map("leader_name_secondary") // ФИО второго руководителя
  
  // Участники
  participantsAge     String?  @map("participants_age") // Возраст участников
  participantsCount   String?  @map("participants_count") // Количество участников
  participantsGender  String?  @map("participants_gender") // Пол участников
  
  // Контент
  content             String?  // Подробная характеристика
  achievements        String?  // Достижения
  repertoire          String?  // Репертуар
  schedule            String?  // Расписание занятий
  
  // Медиа
  imageUrl            String?  @map("image_url") // URL картинки
  videoUrl            String?  @map("video_url") // URL видео
  gallery             String?  @map("gallery") // Галерея изображений (JSON)
  
  // Категория и статус
  category            String?  // Категория (танцы, вокал и т.д.)
  subcategory         String?  // Подкатегория (народные, современные и т.д.)
  status              String?  @default("active") // Статус (active, inactive, archived)
  isActive            Boolean  @default(true) @map("is_active")
  isFeatured          Boolean  @default(false) @map("is_featured") // Рекомендуемый коллектив
  
  // Контакты
  contactPhone        String?  @map("contact_phone") // Контактный телефон
  contactEmail        String?  @map("contact_email") // Контактный email
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  @@map("teams")
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  coverImage  String?  @map("cover_image")
  
  images      GalleryImage[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("galleries")
}

model GalleryImage {
  id          String   @id @default(cuid())
  galleryId   String   @map("gallery_id")
  url         String
  alt         String?
  order       Int      @default(0)
  caption     String?
  
  gallery     Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("gallery_images")
}

model PageView {
  id         String   @id @default(cuid())
  page       String   
  referrer   String?  
  userAgent  String?  
  

  country    String?  
  city       String?  
  
 
  deviceType String?  
  browser    String?  
  os         String?  
  

  visitedAt  DateTime @default(now()) @map("visited_at")
  createdAt  DateTime @default(now())
  

  sessionId  String?  
  
  @@index([page])
  @@index([visitedAt])
  @@index([country])
  @@map("pageviews")
  @@index([visitedAt, page])
  @@index([sessionId, visitedAt])
}